# Python & Byte-compiled files
__pycache__/
*.py[cod]
*$py.class
.DS_Store

# Virtual environments
venv/
env/
.env

# Ignore heavy raw dataset, processed Parquet, and trained weights
data/raw/*.csv
data/processed/*.parquet
models/*.pkl
models/*.pth
models/*.pt

# Ignore generated outputs, logs, and experiment archives
outputs/
results/
logs/

# Preserve folder structure on GitHub using .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!outputs/reports/.gitkeep
!outputs/plots/.gitkeep
!outputs/confusion_matrices/.gitkeep
!outputs/feature_importance/.gitkeep
!outputs/experiment_logs/.gitkeep
!logs/.gitkeep
!results/.gitkeep