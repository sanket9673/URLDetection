# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Heavy Datasets (Ignore raw CSVs & processed Parquet files)
data/raw/*.csv
data/processed/*.parquet

# Heavy Model Binary Artifacts (Upload these to GitHub Releases instead)
models/*.pkl
models/*.pth
models/*.pt

# Temporary logs & cache
logs/*.log
.DS_Store
.idea/
.vscode/

# Preserve directory structures (Do NOT ignore .gitkeep files)
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!outputs/**
!results/**